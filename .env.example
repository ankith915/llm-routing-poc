# Groq (cheap + medium tiers) - create a key at console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (premium tier + router + judge)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides (defaults come from backend/config/models.yaml)
# ROUTER_MODEL=gpt-4o-mini
# EVALUATOR_MODEL=gpt-4o-mini

# Queries used by a "quick" dashboard run (stratified across SIMPLE/MEDIUM/HARD)
# DEMO_QUERY_COUNT=18

# Max concurrent LLM calls during batch experiments.
# Groq FREE plan is 8k tokens/min and one answer call eats ~1.7k of it, so 2 is
# the sensible ceiling - higher just collects 429s and back-off waits. Raise to
# 8 only after upgrading to the Developer plan.
EXPERIMENT_CONCURRENCY=2

# Postgres. Required on serverless hosts, where the filesystem is read-only and
# nothing survives between requests. Leave unset to use the flat-file store.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Time budget for one experiment step, in seconds (must stay under the host's
# function timeout - Vercel allows 300s).
# EXPERIMENT_STEP_SECONDS=50

# OpenRouter is still supported by the loader but unused by the shipped config.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
