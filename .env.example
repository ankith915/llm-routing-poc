# ---------------------------------------------------------------- providers
# Groq serves the cheap and balanced tiers - create a key at console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI serves the frontier tier, the LLM router rung, the judge and embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional third provider; supported by the registry but unused by the shipped config
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------- access
# Virtual API keys: OPTIMIZER_KEY_<NAME>=<secret>:<tenant>:<application>
# With none set the instance is OPEN - anyone who can reach it spends your
# provider credit - and /api/config says so rather than implying it is secured.
# OPTIMIZER_KEY_ACME=sk-acme-demo:acme:ops-assistant
# OPTIMIZER_KEY_GLOBEX=sk-globex-demo:globex:kb-search
# The admin key may change policy, run demo scenarios and see every tenant.
# OPTIMIZER_ADMIN_KEY=sk-admin-demo

# ------------------------------------------------------------------ storage
# Postgres. Required on serverless hosts, where the filesystem is read-only and
# nothing survives between requests. Unset -> flat-file store (local, tests).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ------------------------------------------------------------- feature flags
# Any flag in config/policies.yaml can be overridden here; the dashboard shows
# which layer set each one. Runtime overrides from the API win over these.
# FLAG_ENABLE_SEMANTIC_CACHE=false
# FLAG_ENABLE_BATCH_OPTIMIZATION=false

# ----------------------------------------------------------------- workloads
# Queries in a "quick" evaluation run (stratified across SIMPLE/MEDIUM/HARD)
# DEMO_QUERY_COUNT=18

# Max concurrent provider calls in batch evaluations. Groq's FREE plan allows
# 8k tokens/min and one answer call uses ~1.7k of it, so 2 is the ceiling there;
# a higher value just collects 429s. Raise to 8 after upgrading.
EXPERIMENT_CONCURRENCY=2

# Time budget for one evaluation step, in seconds. Must stay under the host's
# function timeout (Vercel allows 300).
# EXPERIMENT_STEP_SECONDS=50

# Override the router / judge models from config/models.yaml
# ROUTER_MODEL=gpt-4o-mini
# EVALUATOR_MODEL=gpt-4o-mini
